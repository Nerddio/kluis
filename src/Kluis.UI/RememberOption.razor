@* "Remember on this PC": off by default, with the trade-off stated next to the choice. *@
<div class="remember">
    <label>
        <input id="remember" type="checkbox" checked="@Value" disabled="@Disabled"
               @onchange="e => ValueChanged.InvokeAsync(e.Value is true)" />
        Remember on this PC
    </label>
    <p class="hint">@RememberText.Warning</p>
</div>

@code {
    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }
}
